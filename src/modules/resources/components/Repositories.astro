---
import ContentCard from 'src/modules/global/components/CustomCard/ContentCard.astro';
import { fetchResources } from 'src/modules/resources/services/resources.service';

const sortedResources = await fetchResources();
---

<div>
	{
		sortedResources.length === 0 ? (
			<div class='text-center py-12'>
				<p class='text-gray-400 text-lg'>
					Aun no hay recursos publicados. ¡Vuelve pronto!🚀
				</p>
			</div>
		) : (
			<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
				{sortedResources.map((resource) => (
					<ContentCard
						target='_blank'
						rel='noopener noreferrer'
						title={resource.title}
						description={resource.description}
						tags={resource.tags}
						date={resource.date}
						href={resource.url}
					/>
				))}
			</div>
		)
	}

	<div class='text-center mt-8'>
		<a
			href='https://github.com/eliasvelazquezdev/share-it-resources'
			target='_blank'
			class='text-primary hover:text-secondary'
			rel='noopener noreferrer'
			aria-label='Repositorio de la comunidad'>
			¿Quieres ver más recursos? ¡Hazlo aquí! →
		</a>
	</div>
</div>
